# Arithmetic operators and their precedence
print(1 + 2)
print(7 - 10)
print(6 * 7)
print(7 / 2)
print(7 // 2)
print(-7 // 2)
print(7.5 // 2)
print(7 % 3)
print(-7 % 3)
print(7 % -3)
print(5.5 % 2)
print(2 ** 10)
print(2 ** 3 ** 2)
print(-2 ** 2)
print((-2) ** 2)
print(2 + 3 * 4)
print((2 + 3) * 4)
print(10 - 4 - 3)
print(2 * 3 % 4)
let a = 5
print(-a)
