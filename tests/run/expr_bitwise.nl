# Bitwise operators on numbers (32-bit operands, signed 32-bit results)
print(5 | 3)
print(5 & 3)
print(5 ^ 3)
print(~5)
print(~0)
print(1 << 4)
print(1 << 31)
print(-16 >> 2)
print(-16 >>> 28)
print(16 >> 2)
print(0xffffffff | 0)
print(1 | 2 ^ 3 & 4)
print(1 << 2 + 1)
print(1 + 2 | 4)
print(6 & 3 == 2)
