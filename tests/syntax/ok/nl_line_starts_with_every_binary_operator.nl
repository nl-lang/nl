# The full list of operators that continue a line from its
# start: or || and && == != < <= > >= is |> | ^ & << >> >>> <> + * / // % ** as.
x = a
  or a
  || a
  and a
  && a
x = a
  != a
x = a
  <= a
x = a
  is T
x = a
  | a
  ^ a
  & a
  << a
  >> a
  >>> a
  <> a
  + a
  * a
  / a
  // a
  % a
x = a
  ** a
x = a
  as T
