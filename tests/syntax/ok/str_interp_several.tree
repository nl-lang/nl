SOURCE_FILE@0..88
  BLOCK@0..88
    COMMENT@0..62 "# Several interpolations: STR_BEGIN expr STR_MID expr STR_END."
    NEWLINE@62..63 "\n"
    ASSIGN_STMT@63..87
      NAME_REF@63..64
        LNAME@63..64 "s"
      WHITESPACE@64..65 " "
      EQ@65..66 "="
      WHITESPACE@66..67 " "
      INTERP_STRING@67..87
        STR_BEGIN@67..70 "\"#{"
        NAME_REF@70..71
          LNAME@70..71 "a"
        STR_MID@71..79 "} and #{"
        BIN_EXPR@79..84
          NAME_REF@79..80
            LNAME@79..80 "b"
          WHITESPACE@80..81 " "
          PLUS@81..82 "+"
          WHITESPACE@82..83 " "
          LITERAL@83..84
            NUMBER@83..84 "1"
        STR_END@84..87 "}!\""
    NEWLINE@87..88 "\n"
  EOF@88..88 ""
