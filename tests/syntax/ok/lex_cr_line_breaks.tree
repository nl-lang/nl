      WHITESPACE@66..67 " "
      LITERAL@67..68
        NUMBER@67..68 "1"
    NEWLINE@68..69 "\r"
    ASSIGN_STMT@69..74
      NAME_REF@69..70
        LNAME@69..70 "y"
      WHITESPACE@70..71 " "
