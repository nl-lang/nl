SOURCE_FILE@0..100
  BLOCK@0..100
    COMMENT@0..65 "# A string opener inside an interpolation starts a nested string."
    NEWLINE@65..66 "\n"
    ASSIGN_STMT@66..81
      NAME_REF@66..67
        LNAME@66..67 "a"
      WHITESPACE@67..68 " "
      EQ@68..69 "="
      WHITESPACE@69..70 " "
      INTERP_STRING@70..81
        STR_BEGIN@70..73 "\"#{"
        CALL_EXPR@73..79
          NAME_REF@73..74
            LNAME@73..74 "f"
          ARG_LIST@74..79
            L_PAREN@74..75 "("
            LITERAL@75..78
              STRING@75..78 "\"x\""
            R_PAREN@78..79 ")"
        STR_END@79..81 "}\""
    NEWLINE@81..82 "\n"
    ASSIGN_STMT@82..99
      NAME_REF@82..83
        LNAME@82..83 "b"
      WHITESPACE@83..84 " "
      EQ@84..85 "="
      WHITESPACE@85..86 " "
      INTERP_STRING@86..99
        STR_BEGIN@86..89 "\"#{"
        WHITESPACE@89..90 " "
        INTERP_STRING@90..96
          STR_BEGIN@90..93 "\"#{"
          NAME_REF@93..94
            LNAME@93..94 "x"
          STR_END@94..96 "}\""
        WHITESPACE@96..97 " "
        STR_END@97..99 "}\""
    NEWLINE@99..100 "\n"
  EOF@100..100 ""
